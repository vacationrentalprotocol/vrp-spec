  "node_url": [
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://example-host.invalid/book",
      "note": "the node's own domain",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://www.example-host.invalid/book",
      "note": "www. under the node's own domain",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://EXAMPLE-HOST.invalid/book",
      "note": "hosts compare after URL parsing, which lowercases them",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://example-host.invalid:443/book",
      "note": "an explicit default port is the default port",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://book.example-host.invalid/",
      "note": "any other name under the node's domain",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://www.www.example-host.invalid/",
      "note": "only one www. label",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://other-host.invalid/book",
      "note": "another node's domain",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://www.other-host.invalid/book",
      "note": "www. under another node's domain",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://example-host.invalid.other-host.invalid/",
      "note": "the node's domain as a prefix of another host",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://wwwexample-host.invalid/",
      "note": "not a www. label",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://example-host.invalid@other-host.invalid/",
      "note": "the node's domain as userinfo before another host",
      "expected": {
        "reason": "url_userinfo"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://guest@example-host.invalid/book",
      "note": "userinfo on the node's own host",
      "expected": {
        "reason": "url_userinfo"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "https://example-host.invalid:8443/book",
      "note": "a port other than the https default",
      "expected": {
        "reason": "url_port"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "http://example-host.invalid/book",
      "note": "https only (§5.1)",
      "expected": {
        "reason": "url_not_https"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "direct_booking_url",
      "url": "not a url",
      "note": "not an absolute URL",
      "expected": {
        "reason": "url_invalid"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "jwks_url",
      "url": "https://example-host.invalid/.well-known/jwks.json",
      "note": "the JWKS on the node's own domain",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "jwks_url",
      "url": "https://keys.other-host.invalid/jwks.json",
      "note": "a JWKS on another host",
      "expected": {
        "reason": "url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "field": "verified_stay_offer_endpoint",
      "url": "https://www.example-host.invalid/api/verified-stay-offer",
