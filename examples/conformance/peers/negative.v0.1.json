    {
      "name": "entry_object",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          {
            "domain": "example.net",
            "rank": 1
          }
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "entry_not_domain"
      }
    },
    {
      "name": "entry_url",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "https://example.net/"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "entry_not_domain"
      },
      "note": "A domain, never a URL: the client builds the URL itself (§5)."
    },
    {
      "name": "entry_port",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
