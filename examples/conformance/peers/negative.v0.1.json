      "expected": {
        "ignored": "entry_not_domain"
      }
    },
    {
      "name": "entry_u_label",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "exämple.net"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "entry_not_domain"
      },
      "note": "Internationalized labels are written in A-label form (xn--exmple-cua.net)."
    },
    {
      "name": "entry_single_label",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "localhost"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "entry_not_domain"
      }
    },
    {
      "name": "entry_trailing_newline",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net\n"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "entry_not_domain"
      },
      "note": "The schema pattern ends in $(?!\\n) for engines whose $ also matches before a final line break (ADR 0012 D3)."
    },
    {
      "name": "duplicate_entry",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "example.net"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "duplicate_entry"
      }
    },
    {
      "name": "not_sorted",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.org",
          "example.net"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": "not_sorted"
      },
      "note": "Valid against the schema, whose grammar cannot express order; a runtime rule (§3.2)."
    },
    {
      "name": "self",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.com",
          "example.net"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.net"
        ],
        "skipped": [
          {
            "domain": "example.com",
            "reason": "self"
          }
        ]
      },
      "note": "The listing node's own domain is skipped (§3.1 item 3)."
    },
    {
      "name": "subdomain",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "www.example.org"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.net"
        ],
        "skipped": [
          {
            "domain": "www.example.org",
            "reason": "not_host_owned"
          }
        ]
      },
      "note": "Core §2: a name under another domain is not a canonical_domain."
    },
    {
      "name": "public_suffix",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "co.uk",
          "example.net"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.net"
        ],
        "skipped": [
          {
            "domain": "co.uk",
            "reason": "public_suffix"
          }
        ]
      }
    },
    {
      "name": "platform_name",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "villa.myshopify.com"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.net"
        ],
        "skipped": [
          {
            "domain": "villa.myshopify.com",
            "reason": "not_host_owned"
          }
        ]
      },
      "note": "A name a platform hands out under its own domain; the Public Suffix List's PRIVATE section does not count (Core §2)."
    },
    {
      "name": "closed_tld",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "villa.booking"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.net"
        ],
        "skipped": [
          {
            "domain": "villa.booking",
            "reason": "closed_tld"
          }
        ]
      }
    },
    {
      "name": "brand_tld",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "villa.amazon"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.net"
        ],
        "skipped": [
          {
            "domain": "villa.amazon",
            "reason": "closed_tld"
          }
        ]
