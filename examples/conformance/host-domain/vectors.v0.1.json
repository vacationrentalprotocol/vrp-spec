            "exact": true
          },
          "booking": {
            "direct_booking_url": "https://other-host.invalid/book?offer_id=test-vector"
          },
          "agent_permission": {
            "may_quote_as_official_direct_offer": true,
            "must_not_claim_ota_comparison_without_signed_ota_price": true
          }
        },
        "signature": {
          "format": "jws_compact",
          "alg": "EdDSA",
          "kid": "example-host.invalid-test-vector-2026",
          "jws": "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCIsImtpZCI6ImV4YW1wbGUtaG9zdC5pbnZhbGlkLXRlc3QtdmVjdG9yLTIwMjYifQ..XvmzMg2udUYptbzVmp5eTgqNVMB0uUQY94feon0glDNeBQ5MOZG_KuJFV32MUe4JGtB8heupZHKOfgbnQZIiBA"
        }
      },
      "expected": {
        "signature_valid": true,
