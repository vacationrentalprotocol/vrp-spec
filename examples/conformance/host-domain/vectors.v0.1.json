  ],
  "booking_host": [
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://example-host.invalid/book",
      "note": "the node's own domain",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://www.example-host.invalid/book",
      "note": "www. under the node's own domain",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://EXAMPLE-HOST.invalid/book",
      "note": "hosts compare after URL parsing, which lowercases them",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://book.example-host.invalid/",
      "note": "any other name under the node's domain",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://www.www.example-host.invalid/",
      "note": "only one www. label",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://other-host.invalid/book",
      "note": "another node's domain",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://www.other-host.invalid/book",
      "note": "www. under another node's domain",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://example-host.invalid.other-host.invalid/",
      "note": "the node's domain as a prefix of another host",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://wwwexample-host.invalid/",
      "note": "not a www. label",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "https://example-host.invalid@other-host.invalid/",
      "note": "userinfo before another host",
      "expected": {
        "reason": "booking_url_host_mismatch"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "http://example-host.invalid/book",
      "note": "https only (§5.1)",
      "expected": {
        "reason": "booking_url_not_https"
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "direct_booking_url": "not a url",
      "note": "not an absolute URL",
      "expected": {
        "reason": "booking_url_invalid"
      }
    }
  ]
}
