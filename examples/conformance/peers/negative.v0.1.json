{
  "name": "vrp-peers-negative-v0.1",
  "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
  "description": "peers members a client must ignore in full, with the name of the case (spec/peers-v0.1.md §4 item 1: expected.ignored), and entries it must skip while using the rest (§4 item 2: expected.skipped, with Core §2's reason or self). own_domain is the canonical_domain of the node that publishes the member. schema_valid says whether the member is valid against schemas/peers-v0.1.schema.json; order, the Public Suffix List, closed top-level domains and self are runtime rules the schema cannot express. The controls are valid members.",
  "sources": {
    "psl": "Core §2 and examples/conformance/host-domain/vectors.v0.1.json: the ICANN section of the Public Suffix List; these vectors carry only the rules they depend on.",
    "icann_gtlds": "Core §2: amazon is marked specification13 true in ICANN's gTLD list; booking and hotels are the closed top-level domains Core §2 names."
  },
  "psl_icann_rules": [
    "com",
    "net",
    "org",
    "uk",
    "co.uk"
  ],
  "icann_specification13_tlds": [
    "amazon"
  ],
  "closed_tlds": [
    "booking",
    "hotels"
  ],
  "cases": [
    {
      "name": "control",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.co.uk",
          "example.net",
          "example.org"
        ],
        "updated_at": "2026-11-07T15:00:00Z"
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "example.co.uk",
          "example.net",
          "example.org"
        ],
        "skipped": []
      },
      "note": "A valid member: three domains in ascending order."
    },
    {
      "name": "control_empty",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": []
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [],
        "skipped": []
      },
      "note": "An empty list is valid and leads nowhere, like no list."
    },
    {
      "name": "control_a_label",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "xn--exmple-cua.net"
        ]
      },
      "schema_valid": true,
      "expected": {
        "ignored": null,
        "entries": [
          "xn--exmple-cua.net"
        ],
        "skipped": []
      },
      "note": "An internationalized name in A-label form."
    },
    {
      "name": "not_object_array",
      "own_domain": "example.com",
      "peers": [
        "example.net"
      ],
      "schema_valid": false,
      "expected": {
        "ignored": "not_object"
      }
    },
    {
      "name": "not_object_string",
      "own_domain": "example.com",
      "peers": "example.net",
      "schema_valid": false,
      "expected": {
        "ignored": "not_object"
      }
    },
    {
      "name": "unknown_spec_version",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.2",
        "nodes": [
          "example.net"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "unknown_spec"
      },
      "note": "A version this client does not implement."
    },
    {
      "name": "unknown_spec_missing",
      "own_domain": "example.com",
      "peers": {
        "nodes": [
          "example.net"
        ]
      },
      "schema_valid": false,
      "expected": {
        "ignored": "unknown_spec"
      }
    },
    {
      "name": "unexpected_member_scores",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "example.org"
        ],
        "scores": {
          "example.net": 5,
          "example.org": 3
        }
      },
      "schema_valid": false,
      "expected": {
        "ignored": "unexpected_member"
      },
      "note": "Nothing about a listed node belongs in peers (§3)."
    },
    {
      "name": "unexpected_member_featured",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net",
          "example.org"
        ],
        "featured": "example.org"
      },
      "schema_valid": false,
      "expected": {
        "ignored": "unexpected_member"
      }
    },
    {
      "name": "updated_at_not_utc",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": [
          "example.net"
        ],
        "updated_at": "2026-11-07T16:00:00+01:00"
      },
      "schema_valid": false,
      "expected": {
        "ignored": "updated_at_invalid"
      }
    },
    {
      "name": "nodes_missing",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1"
      },
      "schema_valid": false,
      "expected": {
        "ignored": "nodes_invalid"
      }
    },
    {
      "name": "nodes_object",
      "own_domain": "example.com",
      "peers": {
        "spec": "https://vacationrentalprotocol.com/spec/peers-v0.1",
        "nodes": {
          "example.net": true
        }
      },
      "schema_valid": false,
      "expected": {
        "ignored": "nodes_invalid"
      }
    },
