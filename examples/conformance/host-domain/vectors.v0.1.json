  ],
  "redirects": [
    {
      "name": "no_redirect",
      "canonical_domain": "example-host.invalid",
      "requested": "https://example-host.invalid/.well-known/vacation-rental.json",
      "chain": [],
      "note": "the document is served where it was requested",
      "expected": {
        "reason": null
      }
    },
    {
      "name": "to_www",
      "canonical_domain": "example-host.invalid",
      "requested": "https://example-host.invalid/.well-known/vacation-rental.json",
      "chain": [
        "https://www.example-host.invalid/.well-known/vacation-rental.json"
      ],
      "note": "the node's domain redirects to www. under it",
      "expected": {
        "reason": null
      }
    },
    {
      "name": "to_another_host",
      "canonical_domain": "example-host.invalid",
      "requested": "https://example-host.invalid/.well-known/vacation-rental.json",
      "chain": [
        "https://other-host.invalid/.well-known/vacation-rental.json"
      ],
      "note": "a redirect to another node's domain",
      "expected": {
        "reason": "redirect_off_node"
      }
    },
    {
      "name": "via_www_to_another_host",
      "canonical_domain": "example-host.invalid",
      "requested": "https://example-host.invalid/.well-known/vacation-rental.json",
      "chain": [
        "https://www.example-host.invalid/.well-known/vacation-rental.json",
        "https://other-host.invalid/.well-known/vacation-rental.json"
      ],
      "note": "every hop counts",
      "expected": {
        "reason": "redirect_off_node"
      }
    },
    {
      "name": "to_http",
      "canonical_domain": "example-host.invalid",
      "requested": "https://example-host.invalid/.well-known/vacation-rental.json",
      "chain": [
        "http://www.example-host.invalid/.well-known/vacation-rental.json"
      ],
      "note": "a redirect that leaves https",
      "expected": {
        "reason": "redirect_not_https"
      }
    }
  ]
}
