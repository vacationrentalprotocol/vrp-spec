{
  "name": "vrp-host-domain-vectors-v0.1",
  "description": "Host-owned domain (§2), offer bound to the fetched domain (§7), node URLs and redirects (§2, §5.1). A verifier uses the full ICANN section of the Public Suffix List and ICANN's gTLD list; these vectors carry only the entries they depend on. expected.reason is null when the check passes.",
  "sources": {
    "psl": "https://publicsuffix.org/list/public_suffix_list.dat (read 2026-10-17: ICANN section lines 13-11245, PRIVATE section lines 11247-16571; myshopify.com 15873, wixsite.com 16462, booking 7307, hotels 8591, amazon 6959, google 8403, cn 812, 公司.cn 820)",
    "icann_gtlds": "https://www.icann.org/resources/registries/gtlds/v2/gtlds.json (read 2026-10-17: specification13 true for amazon and google; false for booking and hotels, registry operator Booking.com B.V.)"
  },
  "psl_icann_rules": [
    "com",
    "uk",
    "co.uk",
    "se",
    "*.ck",
    "!www.ck",
    "cn",
    "公司.cn",
    "booking",
    "hotels",
    "amazon",
    "google"
  ],
  "psl_private_rules": [
    "platform.example",
    "myshopify.com",
    "wixsite.com"
  ],
  "icann_specification13_tlds": [
    "amazon",
    "google"
  ],
  "closed_tlds": [
    "booking",
    "hotels"
  ],
  "host_owned": [
    {
      "canonical_domain": "example.com",
      "note": "one label under the ICANN suffix com",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example.co.uk",
      "note": "one label under the two-label ICANN suffix co.uk",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example-host.invalid",
      "note": "no ICANN rule matches .invalid, so the default rule * applies",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "xn--exmple-cua.com",
      "note": "an internationalized name in A-label form",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "example.xn--55qx5d.cn",
      "note": "one label under the ICANN suffix 公司.cn, compared in A-label form",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "host.example.ck",
      "note": "the wildcard rule *.ck makes example.ck a suffix",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "www.ck",
      "note": "the exception rule !www.ck makes www.ck registrable",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "www.example.com",
      "note": "a name under the host's domain is not the node's domain",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "villa.platform.example",
      "admitted_by_private_section": true,
      "note": "a name a platform hands out under its own domain; the PRIVATE-section rule platform.example does not count",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "com",
      "note": "a public suffix is not a domain anyone holds",
      "expected": {
        "reason": "public_suffix"
      }
    },
    {
      "canonical_domain": "co.uk",
      "note": "a public suffix is not a domain anyone holds",
      "expected": {
        "reason": "public_suffix"
      }
    },
    {
      "canonical_domain": "xn--55qx5d.cn",
      "admitted_without_a_labels": true,
      "note": "公司.cn is an ICANN suffix once the rule is in A-label form",
      "expected": {
        "reason": "public_suffix"
      }
    },
    {
      "canonical_domain": "example.ck",
      "note": "under *.ck, example.ck is itself a suffix",
      "expected": {
        "reason": "public_suffix"
      }
    },
    {
      "canonical_domain": "Example.com",
      "note": "canonical_domain is lowercase",
      "expected": {
        "reason": "malformed_domain"
      }
    },
    {
      "canonical_domain": "example.com.",
      "note": "no trailing dot",
      "expected": {
        "reason": "malformed_domain"
      }
    },
    {
      "canonical_domain": "exämple.com",
      "note": "internationalized names use the A-label form",
      "expected": {
        "reason": "malformed_domain"
      }
    }
  ],
  "real_world": [
    {
      "canonical_domain": "example.se",
      "note": "a domain under the ICANN suffix se",
      "expected": {
        "reason": null
      }
    },
    {
      "canonical_domain": "villa.myshopify.com",
      "admitted_by_private_section": true,
      "note": "PRIVATE-section rule myshopify.com (a site builder's domain)",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "villa.wixsite.com",
      "admitted_by_private_section": true,
      "note": "PRIVATE-section rule wixsite.com (a site builder's domain)",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "villa.airbnb.com",
      "note": "a name under a marketplace's domain",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "villa.hemmabo.com",
      "note": "a name under an operator's domain, the reference implementation's included",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "annanvilla.exempelplattform.com",
      "note": "a name under a platform's domain",
      "expected": {
        "reason": "not_host_owned"
      }
    },
    {
      "canonical_domain": "villa.booking",
      "note": "booking: a closed top-level domain listed in §2 (Booking.com B.V.)",
      "expected": {
        "reason": "closed_tld"
      }
    },
    {
      "canonical_domain": "villa.hotels",
      "note": "hotels: a closed top-level domain listed in §2 (Booking.com B.V.)",
      "expected": {
        "reason": "closed_tld"
      }
    },
    {
      "canonical_domain": "villa.amazon",
      "note": "amazon: specification13 true in ICANN's gTLD list",
      "expected": {
        "reason": "closed_tld"
      }
    },
    {
      "canonical_domain": "villa.google",
      "note": "google: specification13 true in ICANN's gTLD list",
      "expected": {
        "reason": "closed_tld"
      }
    }
  ],
  "offer_binding": [
    {
      "name": "offer_names_fetched_domain",
      "note": "discovery, JWKS and the signed offer all name the domain they were fetched from",
      "fetched_domain": "example-host.invalid",
      "discovery": {
        "canonical_domain": "example-host.invalid"
      },
      "jwks": {
        "keys": [
          {
            "kty": "OKP",
            "crv": "Ed25519",
            "kid": "example-host.invalid-test-vector-2026",
            "use": "sig",
            "alg": "EdDSA",
            "key_ops": [
              "verify"
            ],
            "x": "8R0pcKv0FNVbtVUQg8hjC6qKPHEG-34D2pGt_yHOKeY"
          }
        ]
      },
      "input": {
        "kind": "signed_verified_stay_offer",
        "protocol_version": "0.1",
        "offer": {
          "kind": "verified_stay_offer",
          "protocol_version": "0.1",
          "canonical_domain": "example-host.invalid",
          "node_id": "example-host.invalid",
          "generated_at": "2026-06-02T12:00:00Z",
          "valid_until": "2026-06-02T12:10:00Z",
          "request": {
            "check_in": "2026-09-12",
            "check_out": "2026-09-15",
            "guests": 2
          },
          "property": {
            "property_id": "example-property",
            "name": "Example Host Stay",
            "url": "https://example-host.invalid/"
          },
          "availability": {
            "available": true,
            "source": "official_host_domain"
          },
          "price": {
            "currency": "EUR",
            "public_total": 123400,
            "agent_total": 123400,
            "minor_unit": true,
            "exact": true
